# AI backend selection: claude_cli | codex_cli | openai | demo | rule
# - claude_cli / codex_cli use your local Claude Code / Codex subscription login
#   (the `claude` / `codex` CLI must be installed and authenticated on this machine).
# - openai uses the OpenAI API and requires OPENAI_API_KEY below.
# - rule uses offline deterministic scoring against your profile keywords (no AI).
# - demo is the offline showcase client (rule scoring + a small "AI-assisted" boost).
# - Leave empty: openai if a key is set below, otherwise honest rule-based scoring.
AI_BACKEND=

# Optional model overrides for the CLI backends (leave empty to use the CLI default).
CLAUDE_CLI_MODEL=
CODEX_CLI_MODEL=

OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
